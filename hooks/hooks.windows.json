{
  "hooks": {
    "SessionStart": [
      {
        "name": "sypnose-memory-restore",
        "description": "Restore session state from .brain/ on start",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File %USERPROFILE%\\.claude\\hooks\\sypnose\\session-start.ps1",
        "timeout": 10000
      }
    ],
    "PreCompact": [
      {
        "name": "sypnose-memory-save",
        "description": "Save session state before compaction",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File %USERPROFILE%\\.claude\\hooks\\sypnose\\pre-compact.ps1",
        "timeout": 10000
      }
    ],
    "Stop": [
      {
        "name": "sypnose-memory-persist",
        "description": "Auto-save progress and commit .brain/ on exit",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File %USERPROFILE%\\.claude\\hooks\\sypnose\\stop.ps1",
        "timeout": 15000,
        "async": true
      }
    ]
  }
}